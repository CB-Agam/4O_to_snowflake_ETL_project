# Existing 4D ODBC settings (used only by scripts/run_initial_etl.py)
FOURD_SERVER=
FOURD_PORT=
FOURD_USERNAME=
FOURD_PASSWORD=
FOURD_DATABASE=
FOURD_QUERY_TIMEOUT_SECONDS=1800

# Snowflake connector settings (key-pair authentication is used when pipe key is set)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# SFTP settings; provide a password or private key.
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_FILE=
SFTP_PRIVATE_KEY_PASSPHRASE=
SFTP_KNOWN_HOSTS_FILE=
SFTP_REMOTE_DIR=/

# Snowpipe REST uses RSA key-pair auth. Register its public key on the Snowflake user.
SNOWFLAKE_PIPE_PRIVATE_KEY_FILE=
SNOWFLAKE_PIPE_PRIVATE_KEY_PASSPHRASE=
# Optional account-specific host, e.g. account.region.cloud.snowflakecomputing.com
SNOWFLAKE_PIPE_HOST=
